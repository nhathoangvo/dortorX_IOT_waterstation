# ── Doctor.X IoT Platform — Environment Config ──────────────────
# Copy file này thành .env và điền giá trị thực

# ── APP ──────────────────────────────────────────────────────────
SECRET_KEY=generate_with__python_-c__import_secrets_print(secrets.token_hex(32))
ACCESS_TOKEN_EXPIRE_MINUTES=120
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
FRONTEND_URL=http://localhost:8000

# ── DATABASE ─────────────────────────────────────────────────────
# SQLite (local dev):
DATABASE_URL=sqlite:///./iot_platform.db
# PostgreSQL (production Railway):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── MQTT ─────────────────────────────────────────────────────────
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=iot_worker
MQTT_PASSWORD=your_mqtt_password
MQTT_TOPIC=doctorx/devices/+/telemetry
MQTT_TLS=false

# ── WORKER → BACKEND ─────────────────────────────────────────────
INGEST_URL=http://localhost:8000/ingest/telemetry
HTTP_TIMEOUT=5
HTTP_RETRIES=3
LOG_LEVEL=INFO

# ── SIMULATOR ────────────────────────────────────────────────────net 
BACKEND_URL=http://127.0.0.1:8000
SIM_DEVICE_ID=water_station
SIM_API_KEY=your_device_api_key_here

# ── EMAIL (tùy chọn — để trống nếu chưa dùng) ───────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
